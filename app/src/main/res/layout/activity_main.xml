<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- App Brand Header -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivAppLogo"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_moon_headphones" />

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.02"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_tagline"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Status Indicator Pill -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_status_badge"
            android:letterSpacing="0.05"
            android:text="@string/status_ready"
            android:textAllCaps="true"
            android:textColor="@color/status_ready"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

        <!-- Circular Timer & Countdown Display -->
        <FrameLayout
            android:id="@+id/layoutTimerRing"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStatusBadge">

            <com.smartsleeptimer.app.ui.CircularTimerView
                android:id="@+id/circularTimerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCountdownDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="30:00"
                    android:textColor="@color/text_primary"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTargetDurationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Duration: 30 min"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Presets Selection Title -->
        <TextView
            android:id="@+id/tvPresetsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.06"
            android:text="@string/preset_header"
            android:textAllCaps="true"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTimerRing" />

        <!-- Preset Chips Container -->
        <LinearLayout
            android:id="@+id/layoutPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPresetsHeader">

            <!-- Row 1: 15m, 30m, 45m -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPreset15m"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_preset_chip_unselected"
                    android:text="@string/preset_15m"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_unselected"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPreset30m"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_preset_chip_selected"
                    android:text="@string/preset_30m"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_selected"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPreset45m"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_preset_chip_unselected"
                    android:text="@string/preset_45m"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_unselected"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 2: 1h, 2h, Custom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPreset1h"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_preset_chip_unselected"
                    android:text="@string/preset_1h"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_unselected"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPreset2h"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_preset_chip_unselected"
                    android:text="@string/preset_2h"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_unselected"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPresetCustom"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_preset_chip_unselected"
                    android:text="@string/preset_custom"
                    android:textAllCaps="false"
                    android:textColor="@color/chip_text_unselected"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 3: 30s Quick Test Button -->
            <Button
                android:id="@+id/btnPreset30sTest"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_rounded"
                android:drawableStart="@drawable/ic_edit_time"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="⚡ 30-Second Quick Verification Timer"
                android:textAllCaps="false"
                android:textColor="@color/primary_accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Controls Section -->
        <FrameLayout
            android:id="@+id/layoutControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutPresets"
            app:layout_constraintVertical_bias="1.0">

            <!-- Primary Start Button (Ready / Completed states) -->
            <Button
                android:id="@+id/btnStart"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_start"
                android:drawableStart="@drawable/ic_play_arrow"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/action_start"
                android:textAllCaps="false"
                android:textColor="@color/btn_start_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Active Controls (Running / Paused states) -->
            <LinearLayout
                android:id="@+id/layoutActiveControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Pause Button (Visible when Running) -->
                <Button
                    android:id="@+id/btnPause"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_button_pause"
                    android:drawableStart="@drawable/ic_pause"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/action_pause"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_pause_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Resume Button (Visible when Paused) -->
                <Button
                    android:id="@+id/btnResume"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_button_resume"
                    android:drawableStart="@drawable/ic_play_arrow"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/action_resume"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_resume_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Cancel Button -->
                <Button
                    android:id="@+id/btnCancel"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_cancel"
                    android:drawableStart="@drawable/ic_stop"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/action_cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_cancel_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
